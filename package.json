{
  "name": "online-boutique",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "fontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @umber-collection/frontend",
    "api:dev": "npm run start:dev --workspace @umber-collection/api",
    "api:build": "npm run build --workspace @umber-collection/api",
    "db:generate": "npm run prisma:generate --workspace @umber-collection/api",
    "db:migrate": "npm run db:migrate --workspace @umber-collection/api --",
    "db:deploy": "npm run db:deploy --workspace @umber-collection/api",
    "db:seed": "npm run db:seed --workspace @umber-collection/api",
    "admin:create": "npm run admin:create --workspace @umber-collection/api",
    "build": "npm run build --workspace @umber-collection/frontend",
    "start": "npm run start --workspace @umber-collection/frontend",
    "lint": "npm run lint --workspace @umber-collection/frontend",
    "postinstall": "npm run prisma:generate --workspace @umber-collection/api"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
